{
  "name": "arbiDexServerBots",
  "version": "0.0.1",
  "description": "Autonomous quote-collection server: 6 CEX + 1 DEX → arbiDexMarketData",
  "author": "Aliaksei Razhnou",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "prepare:dist-cjs": "node -e \"const fs=require('node:fs');fs.mkdirSync('dist',{recursive:true});fs.writeFileSync('dist/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n');\"",
    "build": "nest build && npm run prepare:dist-cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run prepare:dist-cjs && nest start",
    "start:dev": "npm run prepare:dist-cjs && nest start --watch",
    "start:debug": "npm run prepare:dist-cjs && nest start --debug --watch",
    "start:prod": "npm run prepare:dist-cjs && node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "arb-executor": "ts-node src/scripts/run-arb-executor.ts",
    "execute-arb": "ts-node src/scripts/run-execute-arb.ts",
    "dex-cex": "ts-node src/scripts/dex-cex.ts",
    "best-sell-quote": "ts-node src/scripts/best-sell-quote.ts",
    "arb-quoter": "ts-node src/scripts/run-arb-quoter.ts",
    "quote:deployed:arbitrum:ethers": "npx ts-node --project tsconfig.ts-node.json src/scripts/arbQuoter/networks/arbitrum/testDeployedArbitrumEther.ts",
    "quote:deployed:optimism:ethers": "npx ts-node --project tsconfig.ts-node.json src/scripts/arbQuoter/networks/optimism/testDeployedOptimismEther.ts",
    "quote:deployed:base:ethers": "npx ts-node --project tsconfig.ts-node.json src/scripts/arbQuoter/networks/base/testDeployedBaseEther.ts",
    "quote:deployed:blast:ethers": "npx ts-node --project tsconfig.ts-node.json src/scripts/arbQuoter/networks/blast/testDeployedBlastEther.ts",
    "quote:deployed:linea:ethers": "npx ts-node --project tsconfig.ts-node.json src/scripts/arbQuoter/networks/linea/testDeployedLineaEther.ts",
    "quote:deployed:all:ethers": "npm run quote:deployed:arbitrum:ethers && npm run quote:deployed:optimism:ethers && npm run quote:deployed:base:ethers && npm run quote:deployed:blast:ethers && npm run quote:deployed:linea:ethers",
    "quote:deployed:arbitrum": "npx hardhat run src/scripts/arbQuoter/networks/arbitrum/testDeployedArbitrum.ts --network arbitrum",
    "quote:deployed:optimism": "npx hardhat run src/scripts/arbQuoter/networks/optimism/testDeployedOptimism.ts --network optimism",
    "quote:deployed:base": "npx hardhat run src/scripts/arbQuoter/networks/base/testDeployedBase.ts --network base",
    "quote:deployed:blast": "npx hardhat run src/scripts/arbQuoter/networks/blast/testDeployedBlast.ts --network blast",
    "quote:deployed:linea": "npx hardhat run src/scripts/arbQuoter/networks/linea/testDeployedLinea.ts --network linea",
    "quote:deployed:all": "npm run quote:deployed:arbitrum && npm run quote:deployed:optimism && npm run quote:deployed:base && npm run quote:deployed:blast && npm run quote:deployed:linea",
    "start:docker": "docker-compose up --build -d",
    "stop & clear:docker": "docker compose down -v"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.17",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "viem": "2.45.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "hardhat": "^3.5.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
